# Target backend
BASE_URL=https://staging.example.com
BASE_PROJECT=ERP_RMI_SOFULL
TARGET_ENV=staging

# Test user (JANGAN COMMIT file .env asli)
TEST_USER_USERNAME=admin
TEST_USER_PASSWORD=1234

# App under test
APP_PACKAGE=com.company.internalerp
APP_ACTIVITY=.MainActivity
APK_VARIANT=debug
APK_PATH_OVERRIDE=

# Emulator
AVD_NAME=ERP_WATCH_API_30
AVD_API_LEVEL=30
AVD_ABI=x86_64
AVD_DEVICE_PROFILE=pixel_4
AVD_SYSTEM_IMAGE=system-images;android-30;google_apis;x86_64

# Appium
APPIUM_PORT=4723
APPIUM_LOG_LEVEL=info
APPIUM_UIA2_DRIVER_VERSION=2.39.0

# Watch mode
WATCH_MODE=1
KEEP_EMULATOR_OPEN=1
STEP_DELAY_MS=600
RUN_TIMEOUT_SECONDS=300
WIPE_DATA=0

# Evidence
RECORD_VIDEO=1
MAX_VIDEO_SECONDS=180
SCREENSHOT_ON_EACH_STEP=1
