    $before = $st->fetch(PDO::FETCH_ASSOC);
    if (!$before) throw new RuntimeException('PO tidak ditemukan.');
    if (!empty($before['deleted_at'])) throw new RuntimeException('PO sudah berstatus deleted.');

    $statusNow = up($before['status'] ?? '');

    // Dokumen bisnis tidak boleh dihapus sebagai pengganti proses cancel/reversal.
    // Hanya DRAFT/CANCELLED yang boleh soft delete.
    if (!in_array($statusNow, ['DRAFT','CANCELLED'], true)) {
      throw new RuntimeException("PO status {$statusNow} tidak boleh dihapus. Gunakan Revisi / Batalkan PO dari halaman View.");
    }

    $code = (string)($before['po_code'] ?? '');
    $pdo->prepare("UPDATE purchases_po SET deleted_at=NOW() WHERE id=?")->execute([$id]);

    // Rollback PR hanya jika memang tidak ada PO aktif lain.
    if (!empty($before['pr_id'])) {
      $prIdRb = (int)$before['pr_id'];
      $stOther = $pdo->prepare("
        SELECT COUNT(*)
        FROM purchases_po
        WHERE pr_id=?
          AND id<>?
          AND deleted_at IS NULL
          AND status NOT IN ('CANCELLED')
      ");
      $stOther->execute([$prIdRb, $id]);

      if ((int)$stOther->fetchColumn() === 0) {
        // Jangan menimpa status workflow revisi milik WQS.
        $pdo->prepare("
          UPDATE wqs_pr
          SET status='SUBMITTED'
          WHERE id=?
            AND status='PO_CREATED'
        ")->execute([$prIdRb]);
      }
    }

    $stA = $pdo->prepare("SELECT * FROM purchases_po WHERE id=? LIMIT 1");
    $stA->execute([$id]);
    $after = $stA->fetch(PDO::FETCH_ASSOC);

    $pdo->commit();

    rmi_audit_safe('DELETE', 'PURCHASES.PO', $id, $before, $after, [
      'event'=>'soft_delete',
      'po_code'=>$code,
      'status_before'=>$statusNow,
    ]);
    if (function_exists('master_audit')) {
      master_audit($pdo,'purchases_po','purchases_po','SOFT_DELETE',$id,$code,"PO soft deleted: {$code}",[
        'status_before'=>$statusNow
      ]);
    }
    p_audit($pdo,'PO',$code,'SOFT_DELETE',['id'=>$id,'status_before'=>$statusNow]);
    p_flash_set('success','PO '.$code.' berhasil di-soft delete.');
  } catch (Throwable $e) {
    if ($pdo->inTransaction()) $pdo->rollBack();
    if (function_exists('rmi_log_module_error')) {
      rmi_log_module_error('purchases_po',$e,['action'=>'SOFT_DELETE_PO','id'=>$id ?? null]);
    }
    p_flash_set('danger','Gagal soft delete PO: '.$e->getMessage());
  }

