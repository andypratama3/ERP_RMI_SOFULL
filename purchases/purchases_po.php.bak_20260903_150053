    $after = $st2->fetch(PDO::FETCH_ASSOC);

    $pdo->commit();

    rmi_audit_safe('UPDATE', 'PURCHASES.PO', $id, $before, $after, [
      'event' => 'set_status',
      'from_status' => $current,
      'to_status' => $stt,
      'po_code' => $code,
    ]);
    if (function_exists('master_audit')) {
      master_audit(
        $pdo,
        'purchases_po',
        'purchases_po',
        'SET_STATUS',
        $id,
        $code,
        "PO status {$current} -> {$stt}",
        ['from_status'=>$current,'to_status'=>$stt]
      );
    }
    p_audit($pdo,'PO',$code,'SET_STATUS',[
      'id'=>$id,
      'from_status'=>$current,
      'to_status'=>$stt,
