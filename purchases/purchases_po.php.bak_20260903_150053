      <div class="col-12 muted">Gunakan hanya untuk salah produk/qty/unit/kebutuhan. Kesalahan harga, supplier, diskon, PPN, currency, dan payment term diperbaiki di PQP tanpa mengembalikan PR.</div>
OLD;
    $newRevisionText = <<<'NEW'
      <div class="col-12 muted">
        Gunakan hanya sebelum ada PO aktif, untuk salah produk/qty/unit/kebutuhan.
        Jika PO sudah ada, buka detail PO dan gunakan alur <b>Revisi</b> atau <b>Batalkan</b>.
        Kesalahan harga, supplier, diskon, PPN, currency, dan payment term diperbaiki di PQP tanpa mengembalikan PR.
      </div>
NEW;
    replace_once($src, $oldRevisionText, $newRevisionText, 'revision help text');

    if (file_put_contents($target, $src) === false) {
        throw new RuntimeException("Failed writing patched file.");
    }

    echo "PATCH OK\n";
    echo "Target : {$target}\n";
    echo "Backup : {$backup}\n";
    echo "\nNEXT REQUIRED CHECK:\n";
    echo "1. php -l {$target}\n";
    echo "2. Review purchases_po_view.php cancel/revision handler.\n";
    echo "3. Test OPEN -> IN_PRODUCTION -> READY -> CLOSED.\n";
    echo "4. Confirm CANCEL cannot be done via quick status.\n";
    echo "5. Confirm soft delete only works for DRAFT/CANCELLED.\n";
} catch (Throwable $e) {
    // Restore original on patch failure.
    copy($backup, $target);
    fwrite(STDERR, "PATCH FAILED: ".$e->getMessage()."\n");
    fwrite(STDERR, "Original restored from backup.\n");
    exit(10);
}
