    $after = $stA->fetch(PDO::FETCH_ASSOC);

    $pdo->commit();

    $code = (string)($before['po_code'] ?? '');
    rmi_audit_safe('UPDATE','PURCHASES.PO',$id,$before,$after,[
      'event'=>'restore',
      'po_code'=>$code,
      'status'=>$poStatus,
