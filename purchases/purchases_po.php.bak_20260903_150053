/**
 * ERP_RMI_SOFULL - purchases_po.php workflow hardening patch
 *
 * Usage from project root:
 *   php apply_purchases_po_workflow_fix.php purchases/purchases_po.php
 *
 * What this patch changes:
 * - Status mutation moves from GET to POST + CSRF.
 * - Soft delete / restore moves from GET to POST + CSRF.
 * - Quick status can NEVER cancel a PO.
 * - Explicit status transition guard.
 * - Cancel/revision remains delegated to purchases_po_view.php, because
 *   that page owns mandatory reason + downstream guards.
 * - UI separates "Revisi / Cancel" from quick status controls.
 * - Keeps existing audit calls.
 *
 * IMPORTANT:
 * This patch intentionally does NOT implement GR/AP/payment reversal here.
 * Cancellation business logic must remain in purchases_po_view.php.
 */

$target = $argv[1] ?? (__DIR__ . '/purchases_po.php');
if (!is_file($target)) {
    fwrite(STDERR, "Target not found: {$target}\n");
    exit(2);
}

$src = file_get_contents($target);
if ($src === false) {
    fwrite(STDERR, "Cannot read target: {$target}\n");
    exit(3);
}

$backup = $target . '.bak_' . date('Ymd_His');
if (!copy($target, $backup)) {
    fwrite(STDERR, "Cannot create backup: {$backup}\n");
    exit(4);
}

function replace_once(string &$src, string $old, string $new, string $label): void {
    $count = substr_count($src, $old);
    if ($count !== 1) {
        throw new RuntimeException("Patch anchor '{$label}' expected 1 occurrence, found {$count}.");
    }
    $src = str_replace($old, $new, $src);
}

