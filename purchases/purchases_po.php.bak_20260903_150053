  $transition = [
    'DRAFT'         => ['OPEN'],
    'OPEN'          => ['OPEN','IN_PRODUCTION'],
    'IN_PRODUCTION' => ['IN_PRODUCTION','READY'],
    'READY'         => ['READY','CLOSED'],
    'CLOSED'        => ['CLOSED'],
    'CANCELLED'     => [],
  ];

  try {
    $pdo->beginTransaction();

    $st = $pdo->prepare("SELECT * FROM purchases_po WHERE id=? AND deleted_at IS NULL LIMIT 1 FOR UPDATE");
