    $current = up($before['status'] ?? '');
    if (!isset($transition[$current]) || !in_array($stt, $transition[$current], true)) {
      throw new RuntimeException("Transisi status tidak diizinkan: {$current} → {$stt}. Gunakan alur revisi bila perlu koreksi.");
